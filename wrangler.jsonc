{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brick-box",
  // Owner's personal Cloudflare account (verified with `wrangler whoami`, 2026-11-23)
  "account_id": "6b865b6e74012e0c96ada7e531e8cc9e",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/catalog/*"]
  },
  "vars": {
    "LLM_MODEL": "claude-haiku-5-5",
    // a2ui composer only (A/B 2026-11-23: flight seat step 10/10 vs 0/10 on Haiku). Search, widgets, html stay on LLM_MODEL.
    "COMPOSER_MODEL": "claude-sonnet-5-5",
    "JEV_MODEL": "jev-latest",
    "JEV_URL": "https://api.typesafe.ai/v1/systemone",
    "VENUE_NAME": "JAAI (Just Add AI), Überseestadt",
    "VENUE_CITY": "Bremen",
    // Venue and date (Wed 25 Nov 2026) confirmed by the owner 2026-11-24.
    "VENUE_ADDRESS": "Konsul-Smidt-Straße 8p, 28217 Bremen"
  },
  // Per-IP caps on /api/* (src/worker/index.ts). Approximate, per Cloudflare location, 10 or 60 s periods only.
  // They stop a runaway loop or a leaked demo key from spending the Claude/Soniox budgets; they cannot keep the
  // free plan under 100k requests/day (a refused request has already run the Worker). The smoke sends turns
  // one after another and stays well under the turn cap.
  "ratelimits": [
    { "name": "TURN_LIMITER", "namespace_id": "4201", "simple": { "limit": 40, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "4202", "simple": { "limit": 300, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
