{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brick-box",
  // Owner's personal Cloudflare account (verified with `wrangler whoami`, 2026-11-23)
  "account_id": "6b865b6e74012e0c96ada7e531e8cc9e",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/catalog/*"]
  },
  "vars": {
    "LLM_MODEL": "claude-haiku-5-5",
    "JEV_MODEL": "jev-latest",
    "JEV_URL": "https://api.typesafe.ai/v1/systemone",
    "VENUE_NAME": "JAAI (Just Add AI), Überseestadt",
    "VENUE_CITY": "Bremen",
    // Unconfirmed: inferred from the event page's venue sponsor (JAAI HQ). Confirm with the owner.
    "VENUE_ADDRESS": "Konsul-Smidt-Straße 8p, 28217 Bremen"
  },
  "observability": { "enabled": true }
}
